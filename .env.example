# ==========================================
# JARVIS MARK VII - AI CONFIGURATION
# ==========================================
#
# To use Gemini (Google):
# Get a free key here: https://aistudio.google.com/
#
# To use Groq (Fastest Open Source):
# Get a free key here: https://console.groq.com/keys
#
# To use Ollama (100% Free Local AI):
# Download Ollama, run it, and use the URL below. Leave API_KEY blank.
#
# ==========================================

# PRIMARY PROVIDER (Active) - Google Gemini
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_API_KEY="your-google-gemini-api-key-here"
AI_MODEL="gemini-3.5-flash-lite"
AI_VOICE="en-GB-RyanNeural"

# DEDICATED VISION & MEMORY KEYS (Google Gemini)
GEMINI_API_KEY="your-google-gemini-api-key-here"

# DEDICATED VISION KEY (NVIDIA Llama 3.2 90B Vision)
NVIDIA_API_KEY="your-nvidia-api-key-here"

# DEDICATED OCR & DOC INTELLIGENCE KEY (NVIDIA Nemotron 8B)
NEMOTRON_API_KEY="your-nvidia-nemotron-api-key-here"

# ==========================================
# NEURAL HOT-SWAPPING — BACKUP PROVIDERS
# ==========================================
# If the primary provider hits a rate limit (429), Jarvis will
# automatically hot-swap to the next backup provider below.

# Backup 1: NVIDIA Llama 3.3 70B (Secondary Provider)
BACKUP_1_BASE_URL="https://integrate.api.nvidia.com/v1"
BACKUP_1_API_KEY="your-nvidia-backup-api-key-here"
BACKUP_1_MODEL="meta/llama-3.3-70b-instruct"

# Backup 2: Gemini Key 2 (Secondary Vision/Memory Fallback)
BACKUP_2_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
BACKUP_2_API_KEY="your-gemini-backup-2-api-key-here"
BACKUP_2_MODEL="gemini-3.5-flash-lite"

# Backup 3: Gemini Key 3 (Original Vision/Memory Fallback)
BACKUP_3_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
BACKUP_3_API_KEY="your-gemini-backup-3-api-key-here"
BACKUP_3_MODEL="gemini-3.5-flash-lite"

# Backup 4: Mistral AI
BACKUP_4_BASE_URL="https://api.mistral.ai/v1"
BACKUP_4_API_KEY="your-mistral-backup-api-key-here"
BACKUP_4_MODEL="mistral-small-latest"

# Backup 5: Nvidia (Nemotron)
BACKUP_5_BASE_URL="https://integrate.api.nvidia.com/v1"
BACKUP_5_API_KEY="your-nvidia-nemotron-backup-api-key-here"
BACKUP_5_MODEL="nvidia/nemotron-3-super-120b-a12b"

# ==========================================
# EMAIL AUTHORITY (Gmail)
# ==========================================
# To use this, enable 2-Step Verification on your Google Account,
# then generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS="your-email@example.com"
GMAIL_APP_PASSWORD="your-gmail-app-password-here"

GMAIL_2_ADDRESS="your-second-email@example.com"
GMAIL_2_APP_PASSWORD="your-second-gmail-app-password-here"

# ==========================================
# TELEGRAM REMOTE CONTROL
# ==========================================
# Create a bot via @BotFather on Telegram to get your token.
# Your Telegram user ID can be found via @userinfobot.
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-here"
TELEGRAM_ALLOWED_UID="your-telegram-user-id-here"
